{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "0a63cfbf-fc4c-4a8c-83ba-f29bd33274a1",
  "developer": {
    "name": "진학사 어플라이사업본부 운영부",
    "websiteUrl": "https://ops-console-psi.vercel.app",
    "privacyUrl": "https://ops-console-psi.vercel.app/login",
    "termsOfUseUrl": "https://ops-console-psi.vercel.app/login"
  },
  "name": {
    "short": "명보",
    "full": "운영부 상황실 어시스턴트 명보"
